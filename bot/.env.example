# Copy to bot/.env and fill in. bot/.env is gitignored.

# --- Keys --------------------------------------------------------------------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
# Give this key a credit limit of $0. The bot refuses non-:free model ids, and
# the $0 limit means a mistake still cannot bill the account.
OPENROUTER_API_KEY=

# --- Models ------------------------------------------------------------------
# Each mode tries its chain left to right: provider:model, comma-separated.
# A rate limit, server error, or no response within BOT_STALL_MS moves the
# request to the next entry, and a 429 benches that entry until its reset time.
# Check a chain with: node bot/test-models.mjs
#
# Groq counts each model's quota separately, so the second Groq model covers
# the first one's per-minute ceiling on the same key.
BOT_CHAT_CHAIN=groq:qwen/qwen3.6-27b,groq:llama-3.3-70b-versatile
# Job-description matches are the long request and the one that most needs to
# be right, so they start on OpenRouter and fall back to the chat models.
BOT_JD_CHAIN=openrouter:nvidia/nemotron-3-super-120b-a12b:free,groq:qwen/qwen3.6-27b,groq:llama-3.3-70b-versatile

# --- Generation --------------------------------------------------------------
# Reply ceilings in tokens. Reasoning is off upstream, so these buy answer only.
# The JD ceiling also has to fit through Groq's per-minute budget on fallback.
BOT_MAX_TOKENS=600
BOT_JD_MAX_TOKENS=800

# How willing the model is to invent a plausible detail. Keep it low: this bot
# talks about a real person's resume, and a confident fabrication is worse than
# "I don't know".
BOT_TEMPERATURE=0.4

# Fail over (or give up, once a reply has started) if nothing arrives for this long.
BOT_STALL_MS=30000

# Groq reasoning. Effort levels: none (default), low, medium, high — gpt-oss
# models reject none but take low. Output formats: hidden (Groq strips it),
# raw (<think> tags, stripped here), parsed (separate field, dropped here).
# off = send nothing. OpenRouter always asks for none, or hides the reasoning
# if the model insists on it.
BOT_GROQ_REASONING=none

# Prompt size, per provider. With compact on, bot/compact/*.md replaces the
# same-named file in bot/knowledge/. Groq's per-minute token ceiling needs the
# compact prompt; OpenRouter can afford the full one, which gives JD matches
# more to match against. BOT_COMPACT sets both; these override it.
BOT_COMPACT=true
BOT_GROQ_COMPACT=true
BOT_OPENROUTER_COMPACT=false

# --- Who may call it ---------------------------------------------------------
# Not a security boundary (curl ignores CORS) — the rate limits in server.mjs
# are. This just stops other sites embedding your bot as theirs.
BOT_ALLOWED_ORIGINS=https://gmango.dev,https://www.gmango.dev,http://localhost:5173

BOT_PORT=8787

# --- Question log ------------------------------------------------------------
# Appends one JSON line per question to bot/questions.jsonl (gitignored, never
# leaves the host). Addresses are hashed against bot/.log-salt rather than
# stored. `npm run bot:questions` summarises it. Set false to disable entirely.
BOT_LOG_QUESTIONS=true

# --- Lead emails (optional) --------------------------------------------------
# Same Resend account as the contact form. Leave blank and the bot still runs;
# it just logs leads to the console instead of mailing them.
RESEND_API_KEY=
LEAD_TO=genova@gmango.dev
LEAD_FROM=site@gmango.dev
