# Copy to bot/.env and fill in. bot/.env is gitignored.

# --- API Configuration -------------------------------------------------------
# Set GROQ_API_KEY to use Groq API (free tier: 30 RPM, 14.4K RPD)
# Get your API key from: https://console.groq.com/keys
# Leave blank to fall back to local Ollama (requires Ollama installed)
GROQ_API_KEY=

# Model to use
# For Groq: llama-3.1-8b-instant (fast) or llama-3.3-70b-versatile (smart)
# For Ollama: qwen3:8b or qwen3:4b
BOT_MODEL=llama-3.1-8b-instant

# --- Ollama (fallback when Groq hits rate limits) ---------------------------
# If Groq returns 429 (rate limit) or fails, the bot automatically falls back
# to Ollama if it's running. This provides seamless degradation.
OLLAMA_URL=http://127.0.0.1:11434

# Ollama model for fallback (can be different from BOT_MODEL)
# Set to qwen3:4b or qwen3:8b for local fallback
BOT_OLLAMA_FALLBACK_MODEL=qwen3:4b

# Bot server port
BOT_PORT=8787

# --- Generation Settings -----------------------------------------------------
# Ceiling on reply length (tokens). Generation time is linear in tokens produced.
BOT_MAX_TOKENS=800

# Job-description mode: longer answers for pasted job postings
BOT_JD_MAX_TOKENS=1200

# --- Per-backend reasoning and prompt size -----------------------------------
# The two backends want opposite settings, so they are configured separately.
#
# Groq: turn reasoning OFF. BOT_MODEL may be a reasoning model (qwen3.6), and
# left to its default it returns its working in the reply — the "talking out
# loud" problem. Off is also cheaper against the free tier's 8K TPM ceiling.
#   none   = do not reason at all (default, fastest)
#   hidden = reason, but Groq strips it server-side (costs tokens, better answers)
#   raw    = reasoning inline in <think> tags; the server strips them
#   parsed = reasoning in its own field; the server drops it
#   off    = send nothing, let Groq decide
BOT_GROQ_REASONING=none

# Ollama: leave thinking ON. Unlike Groq's flag this does not stop the model
# reasoning — it routes the reasoning into a separate channel the server drops.
# Setting it false puts the working back into the visible reply.
BOT_THINK=true

# Ollama's own ceiling. It needs to be MUCH higher than the Groq one: with
# think:true the reasoning and the answer come out of this single budget, so a
# 600-token ceiling buys a well-reasoned empty bubble. Defaults to
# max(BOT_MAX_TOKENS, 1600) when unset.
BOT_OLLAMA_MAX_TOKENS=1600
BOT_OLLAMA_JD_MAX_TOKENS=1800

# Prompt size, per backend. BOT_COMPACT sets both; these override it one at a
# time. With compact on, bot/compact/*.md replaces the same-named file in
# bot/knowledge/ — measured 5,345 prompt tokens vs 9,188 with it off.
# 9,188 is 75% of a 12,288 context, which leaves little room for conversation,
# so keeping it on for Ollama is recommended.
BOT_COMPACT=true
# BOT_GROQ_COMPACT=true
# BOT_OLLAMA_COMPACT=true

# How willing the model is to invent a plausible detail. Keep it low: this bot
# talks about a real person's resume, and a confident fabrication is worse than
# "I don't know".
BOT_TEMPERATURE=0.4

# Give up if no token arrives for this long. Groq is fast; Ollama on a slow GPU
# can stall. Set higher if running Ollama on CPU.
BOT_STALL_MS=60000

# --- Who may call it ---------------------------------------------------------
# Not a security boundary (curl ignores CORS) — the rate limits in server.mjs
# are. This just stops other sites embedding your laptop as their chat bot.
BOT_ALLOWED_ORIGINS=https://gmango.dev,https://www.gmango.dev,http://localhost:5173

# --- Question log ------------------------------------------------------------
# Appends one JSON line per question to bot/questions.jsonl (gitignored, never
# leaves the laptop). Addresses are hashed against bot/.log-salt rather than
# stored. `npm run bot:questions` summarises it. Set false to disable entirely.
BOT_LOG_QUESTIONS=true

# --- Lead emails (optional) --------------------------------------------------
# Same Resend account as the contact form. Leave blank and the bot still runs;
# it just logs leads to the console instead of mailing them.
RESEND_API_KEY=
LEAD_TO=genova@gmango.dev
LEAD_FROM=site@gmango.dev

# --- Rate Limit Info (Groq Free Tier) ----------------------------------------
# With ~6,237 token prompt + conversation:
# - 30 requests per minute (RPM)
# - 14,400 requests per day (RPD)
# - 8,000 tokens per minute (TPM) - this is usually the bottleneck
#
# Capacity estimate:
# - First message: ~7,200 tokens (prompt + user + response) = ~1 msg/min
# - Cached messages: ~1,000 tokens (user + response) = ~8 msg/min
# - Daily: ~1,500-11,000 messages depending on cache efficiency
#
# For a portfolio site with <100 visitors/day, this is plenty!
# When Groq hits limits, it automatically falls back to Ollama.

# --- Settings removed (not needed for Groq API) ------------------------------
# BOT_KEEP_ALIVE - Groq is stateless, no model loading needed
# BOT_NUM_CTX - Llama 3.1 has 131K context, no manual configuration needed
# BOT_JD_NUM_CTX - Same as above
# BOT_WARMUP_MS - Groq API is instant, no warmup needed
#
# BOT_THINK is NOT in this list: it still governs the Ollama fallback, which
# runs a reasoning model even when Groq is the primary backend.
