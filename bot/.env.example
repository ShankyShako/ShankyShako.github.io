# Copy to bot/.env and fill in. bot/.env is gitignored.

# --- model ---------------------------------------------------------------
BOT_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
BOT_PORT=8787

# How long Ollama keeps the weights in memory after the last message. Long
# enough that a visitor is never waiting on a cold load.
BOT_KEEP_ALIVE=30m

# Ceiling on reply length. Generation time is linear in tokens produced, so
# this is the main dial for "cheap".
# Covers the model's private scratchpad and the spoken answer together. Not a
# cost control — nothing here is billed. It is a latency control: generation is
# linear in tokens, so 1500 at ~40 tok/s is ~35s worst case before the answer
# finishes. Lower it if replies feel slow, raise it if answers get cut off.
BOT_MAX_TOKENS=1500

# MUST be large enough for the system prompt AND the conversation. The prompt
# assembled from bot/knowledge/ is ~7.7k tokens, so 8192 leaves nothing and the
# bot answers in truncated fragments — or, on a small GPU, stalls for minutes.
# `npm run bot` measures the real count at startup and refuses to serve if this
# is too low. Raising it grows the KV cache linearly; see the VRAM table in
# docs/CHATBOT.md before pushing it on a 6-8 GB card.
BOT_NUM_CTX=12288

# Give up if no token arrives for this long. Ollama's own timeout is 5 minutes,
# by which point every browser has already shown "NetworkError".
BOT_STALL_MS=60000

# Ceiling on the startup warmup pass. Raise on a slow GPU — a cold prompt pass
# on a 6 GB card can take a couple of minutes the first time.
BOT_WARMUP_MS=180000

# Job-description mode. A pasted posting is 1-2k tokens before the model has
# written a word, and deserves a longer answer than a chat reply.
#
# These two decide whether the bot fits in GPU memory. On a 6 GB card running
# an 8B model, drop them to 8192 / 500 or stay on qwen3:4b — see docs/CHATBOT.md.
BOT_JD_NUM_CTX=16384
BOT_JD_MAX_TOKENS=700

# Leave this alone. `true` routes the model's reasoning into a separate channel
# that the gateway drops; `false` does NOT stop a reasoning model reasoning, it
# just forces the reasoning into the reply where the visitor reads it.
BOT_THINK=true

# How willing the model is to invent a plausible detail. Keep it low: this bot
# talks about a real person's resume, and a confident fabrication is worse than
# "I don't know".
BOT_TEMPERATURE=0.4

# --- who may call it -----------------------------------------------------
# Not a security boundary (curl ignores CORS) — the rate limits in server.mjs
# are. This just stops other sites embedding your laptop as their chat bot.
BOT_ALLOWED_ORIGINS=https://gmango.dev,https://www.gmango.dev,http://localhost:5173

# --- question log --------------------------------------------------------
# Appends one JSON line per question to bot/questions.jsonl (gitignored, never
# leaves the laptop). Addresses are hashed against bot/.log-salt rather than
# stored. `npm run bot:questions` summarises it. Set false to disable entirely.
BOT_LOG_QUESTIONS=true

# --- lead emails (optional) ----------------------------------------------
# Same Resend account as the contact form. Leave blank and the bot still runs;
# it just logs leads to the console instead of mailing them.
RESEND_API_KEY=
LEAD_TO=genova@gmango.dev
LEAD_FROM=site@gmango.dev
