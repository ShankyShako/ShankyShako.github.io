# Copy to bot/.env and fill in. bot/.env is gitignored.

# --- model ---------------------------------------------------------------
BOT_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
BOT_PORT=8787

# How long Ollama keeps the weights in memory after the last message. Long
# enough that a visitor is never waiting on a cold load.
BOT_KEEP_ALIVE=30m

# Ceiling on reply length. Generation time is linear in tokens produced, so
# this is the main dial for "cheap".
BOT_MAX_TOKENS=400
BOT_NUM_CTX=8192

# Job-description mode. A pasted posting is 1-2k tokens before the model has
# written a word, and deserves a longer answer than a chat reply.
#
# These two decide whether the bot fits in GPU memory. On a 6 GB card running
# an 8B model, drop them to 8192 / 500 or stay on qwen3:4b — see docs/CHATBOT.md.
BOT_JD_NUM_CTX=16384
BOT_JD_MAX_TOKENS=700

# qwen3 thinks out loud unless told not to, which burns tokens a visitor never
# sees. Set to true only if you switch to a model where you want the reasoning.
BOT_THINK=false

# How willing the model is to invent a plausible detail. Keep it low: this bot
# talks about a real person's resume, and a confident fabrication is worse than
# "I don't know".
BOT_TEMPERATURE=0.4

# --- who may call it -----------------------------------------------------
# Not a security boundary (curl ignores CORS) — the rate limits in server.mjs
# are. This just stops other sites embedding your laptop as their chat bot.
BOT_ALLOWED_ORIGINS=https://gmango.dev,https://www.gmango.dev,http://localhost:5173

# --- question log --------------------------------------------------------
# Appends one JSON line per question to bot/questions.jsonl (gitignored, never
# leaves the laptop). Addresses are hashed against bot/.log-salt rather than
# stored. `npm run bot:questions` summarises it. Set false to disable entirely.
BOT_LOG_QUESTIONS=true

# --- lead emails (optional) ----------------------------------------------
# Same Resend account as the contact form. Leave blank and the bot still runs;
# it just logs leads to the console instead of mailing them.
RESEND_API_KEY=
LEAD_TO=genova@gmango.dev
LEAD_FROM=site@gmango.dev
